{
    "manifest_version": 3,
    "name": "Extension Testing",
    "version": "1.0.0",
    "description": "Tesing extension with React, Typescript and Webpack",
    "action": {
      "default_popup": "index.html"
    },
    "background": {
      "service_worker": "background.js"
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["contentScript.js"]
      }
    ]
  }
  